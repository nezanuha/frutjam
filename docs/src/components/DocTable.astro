---
/**
 * A Markdown table carrying the classes it had in frutjam.com's template,
 * e.g. <div class="overflow-y-auto max-h-72"><table class="table table-sm not-prose">.
 */
interface Props {
  wrapper?: string;
  table?: string;
}

const { wrapper, table } = Astro.props;
let html = await Astro.slots.render('default');
if (table) html = html.replace(/<table(?=[\s>])/, `<table class="${table}"`);
---

{wrapper !== undefined ? <div class={wrapper} set:html={html} /> : <Fragment set:html={html} />}
