---
// Ported from frutjam.com's Django template /frontend/templates/404.html. — edit this file directly.
import Base from '@/layouts/Base.astro';
---

<Base path="/404" links={false} sidebar={true}>
<main id="main-content" class="col-span-12 flex flex-col items-center justify-center min-h-[60vh] px-5 text-center not-prose">
            <p class="text-8xl font-bold text-primary mb-4">404</p>
            <h1 class="heading-2xl mb-2">Page not found</h1>
            <p class="para mb-8 max-w-sm">The page you're looking for doesn't exist or has been moved.</p>
            <div class="flex flex-wrap gap-3 justify-center">
                <a href="/" class="btn btn-primary btn-sm">Go home</a>
                <a href="/components" class="btn btn-outline btn-sm">Browse components</a>
            </div>
        </main>
</Base>
