---
/**
 * frutjam.com's page shell: templates/cotton/frontend/base.html and body.html,
 * with the head partials (meta_basic, link_relationships, resource_css,
 * script_core). Page-specific head tags come from src/lib/head.ts.
 */
import '@/styles/main.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PluginHeader from '@/components/PluginHeader.astro';
import PluginFooter from '@/components/PluginFooter.astro';
import Aside from '@/components/Aside.astro';
import { headTags } from '@/lib/head';
import { SITE, isEnglishOnly } from '@/lib/site';
import { DEFAULT_LANG, LANGUAGES, langUrl, splitLang } from '@/lib/i18n';

interface Props {
  /** URL path, e.g. "/components/button"; selects the page's head tags. */
  path: string;
  /** Pages whose template included head/link_relationships.html. */
  links?: boolean;
  /** Category and doc pages carry the navigation sidebar. */
  sidebar?: boolean;
}

const { path, links = true, sidebar = false } = Astro.props;
const tags = await headTags(path);
const canonical = path === '/' ? SITE : `${SITE}${path}`;
const englishOnly = isEnglishOnly(path);
const { lang, path: basePath } = splitLang(path);
const locale = (LANGUAGES.find((l) => l.code === lang) ?? LANGUAGES[0]).ogLocale;
const isMarkdownEditor = basePath === '/plugins/markdown-editor';
const starKey = isMarkdownEditor ? 'fj-star-banner-md' : 'fj-star-banner';
const plugin = isMarkdownEditor
  ? {
      name: 'Markdown Text Editor',
      path: '/plugins/markdown-editor',
      repo: 'https://github.com/nezanuha/markdown-text-editor',
      npm: 'https://www.npmjs.com/package/markdown-text-editor',
    }
  : undefined;
---

<!DOCTYPE html>
<html lang={lang} dir="ltr" data-theme="darkberry">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    {tags.map(({ tag, attrs, content }) =>
      tag === 'title' ? <title>{content}</title>
      : tag === 'script' ? <script is:inline type="application/ld+json" set:html={content} />
      : tag === 'link' ? <link {...attrs} />
      : <meta {...attrs} />
    )}
    <meta name="author" content="Nezanuha" />
    <meta property="og:site_name" content="Frutjam" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:site" content="@FrutjamUI" />
    <meta name="apple-mobile-web-app-title" content="Frutjam" />

    {links && <link rel="canonical" href={canonical} />}
    {links && !englishOnly && (
      <Fragment>
        {LANGUAGES.map((language) => (
          <link rel="alternate" hreflang={language.code} href={`${SITE}${langUrl(language.code, basePath)}`.replace(/\/$/, '')} />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${SITE}${langUrl(DEFAULT_LANG, basePath)}`.replace(/\/$/, '')} />
      </Fragment>
    )}
    <link rel="icon" type="image/png" href="/favicon/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preload" href="/static/frontend/fonts/gNMKW3F-SZuj7xmf-HY.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline type="importmap">{"imports": {"frutjam/js": "/_frutjam/js/index.js"}}</script>

    <script is:inline>
      (function() {
      const savedTheme = localStorage.getItem('selected-theme') || 'system';
      let themeToApply = savedTheme;

      if (savedTheme === 'system') {
          themeToApply = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'darkberry'
          : 'snowberry';
      }

      document.documentElement.setAttribute('data-theme', themeToApply);

      document.addEventListener('DOMContentLoaded', () => {
          const activeElement = document.querySelector(`.${savedTheme}-theme`);

          if (activeElement) {
              activeElement.classList.add('menu-active');
              const radio = activeElement.querySelector('input[type="radio"]');
              if (radio) radio.checked = true;
          }
      });
      })();
    </script>
  </head>
  <body class="font-primary bg-[repeating-linear-gradient(315deg,var(--pattern-fg)_0,var(--pattern-fg)_1px,transparent_0,transparent_50%)] bg-size-[10px_10px] bg-fixed [--pattern-fg:var(--color-base-950)]/5 dark:[--pattern-fg:var(--color-base-200)]/5">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded focus:bg-white dark:focus:bg-black focus:text-black dark:focus:text-white focus:ring-2 focus:ring-blue-600 focus:outline-none">Skip to main content</a>
    <div class="sticky top-0 z-999">
      {plugin ? <PluginHeader {...plugin} /> : <Header />}
    </div>
    <div class="grid grid-cols-12 lg:px-4">
      {plugin ? (
        /* No component navigation: the plugin stands on its own. */
        <div class="col-span-12 relative max-w-5xl mx-auto w-full">
          <slot />
          <PluginFooter {...plugin} />
        </div>
      ) : sidebar ? (
        <Fragment>
          <div class="hidden lg:block col-span-2">
            <aside class="sidebar gap-y-2 px-2 top-24 py-5 h-[calc(100vh-6rem)] overflow-y-auto">
              <Aside place="sidebar" />
            </aside>
          </div>
          <div class="col-span-12 lg:col-span-10">
            <slot />
            <Footer />
          </div>
        </Fragment>
      ) : (
        <div class="col-span-12 relative">
          <slot />
          <Footer />
        </div>
      )}
    </div>
    {import.meta.env.PROD && (
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NXRKTW2T" height="0" width="0" class="invisible hidden"></iframe></noscript>
    )}
    {/* Dismissible prompt, bottom right. `toast` is fixed and already defaults
        to bottom-end, and `card` is position: relative, so the close button
        needs no positioning context of its own. */}
    <div id="github-star-banner" class="toast">
      <div role="status" class="card card-outline shadow-lg w-80 max-w-[calc(100vw-2rem)]">
        <button type="button" aria-label="Dismiss" class="btn btn-xs btn-ghost btn-square absolute top-2 end-2" onclick={`document.getElementById('github-star-banner').remove(); localStorage.setItem('${starKey}', '1')`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
        <div class="card-content gap-2">
          <h2 class="card-title text-sm pe-6">Found this useful?</h2>
          <p class="text-xs">{isMarkdownEditor
            ? "Star Markdown Editor on GitHub. It's how other developers discover it."
            : "Star Frutjam on GitHub. It's how other developers discover it."}</p>
          <div class="card-actions justify-end">
            <a href={isMarkdownEditor ? "https://github.com/nezanuha/markdown-text-editor" : "https://github.com/nezanuha/frutjam"} target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-primary btn-pill">Star on GitHub</a>
          </div>
        </div>
      </div>
    </div>
    <script is:inline set:html={`if(localStorage.getItem('${starKey}'))document.getElementById('github-star-banner').remove();`}></script>
    <script>
      import '@/scripts/app';
    </script>
  </body>
</html>
