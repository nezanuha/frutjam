---
/**
 * The full palette on /docs/colors: every colour family against every step.
 *
 * The family list is read from the installed package rather than written here,
 * the way ThemeCards reads themes from the CSS. Add a colour to the library and
 * its row appears, in every language, with nothing to edit in the MDX.
 *
 * Swatches read the custom property directly rather than using bg-* utilities:
 * a class built from a template literal is invisible to Tailwind's scanner, so
 * most of the grid came out blank. var(--color-x-y) is also what the utility
 * resolves to, and it keeps following a theme switch.
 */
import baseCss from 'frutjam/css/base?raw';

interface Props {
  /** Families to leave out, for a page that only wants the brand colours. */
  exclude?: string[];
}

const { exclude = [] } = Astro.props;

const STEPS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] as const;

/** Anything declaring --color-<name>-50 is a family with a full scale. */
const families = [...new Set([...baseCss.matchAll(/--color-([a-z]+)-50\s*:/g)].map(([, name]) => name))]
  .filter((name) => !exclude.includes(name))
  .sort((a, b) => {
    // Brand colours first, then status, then the two surfaces. Alphabetical
    // would bury primary under accent and base.
    const order = ['primary', 'secondary', 'accent', 'info', 'success', 'warning', 'error', 'neutral', 'base'];
    return order.indexOf(a) - order.indexOf(b);
  });
---

<div class="fj-palette not-prose" role="table" aria-label="Every colour family at every scale step">
  <div class="fj-palette-head" role="row">
    <span class="fj-palette-name" role="columnheader">Colour</span>
    {STEPS.map((step) => <span class="fj-step" role="columnheader">{step}</span>)}
  </div>

  {families.map((name) => (
    <div class="fj-palette-row" role="row">
      <span class="fj-palette-name" role="rowheader"><code>{name}</code></span>
      {STEPS.map((step) => (
        <span
          class="fj-swatch"
          style={`background: var(--color-${name}-${step})`}
          role="cell"
          title={`--color-${name}-${step}  ·  bg-${name}-${step}`}
        ><span class="sr-only">{name} {step}</span></span>
      ))}
    </div>
  ))}
</div>

<style>
  .fj-palette {
    display: grid;
    gap: 0.35rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .fj-palette-head,
  .fj-palette-row {
    display: grid;
    grid-template-columns: 5.5rem repeat(11, minmax(2.25rem, 1fr));
    gap: 0.35rem;
    align-items: center;
    min-width: 34rem;
  }

  .fj-palette-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-on-base);
  }
  .fj-palette-name code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .fj-step {
    font-size: 0.6875rem;
    text-align: center;
    color: color-mix(in oklch, var(--color-on-base) 55%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .fj-swatch {
    display: block;
    height: 2.5rem;
    border-radius: calc(var(--border-radius) * 1.5);
    border: 1px solid color-mix(in oklch, var(--color-on-base) 10%, transparent);
  }
</style>
