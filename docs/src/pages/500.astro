// Ported from frutjam.com's Django template /frontend/templates/500.html. — edit this file directly.
import Base from '@/layouts/Base.astro';
---

<Base path="/500" links={false} sidebar={false}>
<main id="main-content" class="col-span-12 flex flex-col items-center justify-center min-h-[60vh] px-5 text-center not-prose">
            <p class="text-8xl font-bold text-primary mb-4">500</p>
            <h1 class="heading-2xl mb-2">Something went wrong</h1>
            <p class="para mb-8 max-w-sm">We're experiencing a server issue. Please try again in a moment.</p>
            <a href="/" class="btn btn-primary btn-sm">Go home</a>
        </main>
</Base>
