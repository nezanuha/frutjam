---
import EditLink    from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination  from '@astrojs/starlight/components/Pagination.astro';

const COLUMNS = [
  {
    title: 'Getting Started',
    links: [
      { label: 'Overview',      href: '/docs/overview' },
      { label: 'Installation',  href: '/docs/installation' },
      { label: 'Configuration', href: '/docs/configuration' },
      { label: 'Themes',        href: '/docs/themes' },
    ],
  },
  {
    title: 'Components',
    links: [
      { label: 'Button',  href: '/components/button' },
      { label: 'Modal',   href: '/components/modal' },
      { label: 'Navbar',  href: '/components/navbar' },
      { label: 'Drawer',  href: '/components/drawer' },
      { label: 'All components →', href: '/components/button' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Blog',     href: '/blog' },
      { label: 'Blocks',   href: '/blocks/header' },
      { label: 'GitHub',   href: 'https://github.com/nezanuha/frutjam' },
      { label: 'Discord',  href: 'https://discord.gg/FvjytjQSSZ' },
      { label: 'npm',      href: 'https://www.npmjs.com/package/frutjam' },
    ],
  },
  {
    title: 'Cherry MCP',
    links: [
      { label: 'What is Cherry?', href: 'https://frutjam.com/products/cherry' },
      { label: 'Claude Code',     href: 'https://frutjam.com/products/cherry' },
      { label: 'Cursor',          href: 'https://frutjam.com/products/cherry' },
      { label: 'VS Code',         href: 'https://frutjam.com/products/cherry' },
    ],
  },
];
---

<div class="fj-doc-footer">
  <EditLink />
  <LastUpdated />
  <Pagination />
</div>

<footer class="fj-site-footer not-content">
  <div class="fj-site-footer__grid">
    <div class="fj-site-footer__brand">
      <a href="/" class="fj-site-footer__logo">Frutjam</a>
      <p>CSS-only Tailwind CSS v4 component library. 65+ accessible UI components, zero JavaScript, WCAG AA guaranteed.</p>
      <p class="fj-site-footer__copy">© {new Date().getFullYear()} Frutjam. MIT License.</p>
    </div>

    {COLUMNS.map((col) => (
      <div class="fj-site-footer__col">
        <h3>{col.title}</h3>
        <ul>
          {col.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</footer>

<style>
  .fj-doc-footer {
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--sl-color-hairline);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .fj-site-footer {
    margin-block-start: 3rem;
    padding: 3rem 1.5rem 2rem;
    border-block-start: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-sidebar);
  }

  .fj-site-footer__grid {
    max-width: 64rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 2fr repeat(4, 1fr);
    gap: 2rem;
  }

  @media (max-width: 60rem) {
    .fj-site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .fj-site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 36rem) {
    .fj-site-footer__grid {
      grid-template-columns: 1fr;
    }
  }

  .fj-site-footer__logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
    text-decoration: none;
    display: inline-block;
    margin-block-end: 0.75rem;
  }

  .fj-site-footer__brand p {
    font-size: 0.875rem;
    color: var(--sl-color-gray-4);
    line-height: 1.6;
    max-width: 24rem;
  }

  .fj-site-footer__copy {
    margin-block-start: 1rem;
    font-size: 0.8rem !important;
    color: var(--sl-color-gray-5) !important;
  }

  .fj-site-footer__col h3 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-4);
    margin-block-end: 0.75rem;
  }

  .fj-site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fj-site-footer__col a {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .fj-site-footer__col a:hover {
    color: var(--sl-color-white);
  }
</style>
