---
/** frutjam.com's templates/cotton/snippet.html (<c-snippet>) */
import { highlightCode } from '@/lib/highlight';
import { splitLang, useTranslations } from '@/lib/i18n';

interface Props {
  /** The default slot: preview markup and code in one. */
  code?: string;
  html?: string;
  css?: string;
  js?: string;
  react?: string;
  vue?: string;
  svelte?: string;
  view?: 'both' | 'preview' | 'code';
  lang?: string;
  id?: string;
  class?: string;
  title?: string;
}

const { code = '', html, css, js, react, vue, svelte, lang, id, title, class: previewClass } = Astro.props;
const t = useTranslations(splitLang(Astro.url.pathname).lang);
const view = Astro.props.view ?? 'both';
const showPreview = view === 'preview' || view === 'both';
const hasTabs = Boolean(html || css || js || react || vue || svelte);
const uid = Math.random().toString(16).slice(2, 10);
const toggleId = `view-full-code-${id ?? uid}`;
const tabName = `snippet-tabs-${id ?? uid}`;
const singleLine = (v?: string) => !String(v ?? '').trim().includes('\n');
const allSingleLine = [html, css, js, react, vue, svelte].filter(Boolean).every(singleLine);
const checked = showPreview && (hasTabs ? allSingleLine : singleLine(code));

// Vite's dev dependency scanner regex-matches script tags anywhere in .astro
// source, frontmatter strings included, so the tag is never written literally.
const SCRIPT = 'script';
const previewHtml = hasTabs
  ? `${css ? `<style>${css}</style>` : ''}${html ?? ''}${js ? `<${SCRIPT} type="module">${js}</${SCRIPT}>` : ''}`
  : code;

const tabs = [
  html && { label: 'HTML', code: html, lang: 'html' },
  css && { label: 'CSS', code: css, lang: 'css' },
  js && { label: 'JS', code: js, lang: 'javascript' },
  react && { label: 'React', code: react, lang: 'jsx' },
  vue && { label: 'Vue', code: vue, lang: 'html' },
  svelte && { label: 'Svelte', code: svelte, lang: 'html' },
].filter((t): t is { label: string; code: string; lang: string } => Boolean(t));

const highlighted = hasTabs
  ? await Promise.all(tabs.map((t) => highlightCode(t.code, t.lang)))
  : [await highlightCode(code, lang ?? 'html')];
---

<div data-view={view} data-plan="free" data-lang={hasTabs ? undefined : (lang ?? 'html')} class="snippet-container collapsible-group join join-vertical border border-base-soft rounded-xl not-prose w-full mb-4">

  {showPreview && (
  <Fragment>
  <div data-pagefind-ignore class:list={['preview-container join-item', { 'overflow-auto': !hasTabs }, 'bg-[repeating-linear-gradient(315deg,var(--pattern-fg)_0,var(--pattern-fg)_1px,transparent_0,transparent_50%)] bg-size-[10px_10px] bg-fixed [--pattern-fg:var(--color-base-950)]/5 dark:[--pattern-fg:var(--color-base-200)]/5 p-4']} aria-label={title ? `${title} preview` : 'Preview'} translate="no">
    <div class:list={['relative min-h-32 py-10 flex flex-wrap gap-3 items-center justify-center', previewClass, 'p-0.5']} set:html={previewHtml} />
  </div>
  <span class="divider divider-horizontal"></span>
  </Fragment>
  )}

  <div data-pagefind-ignore class="header header-sm header-transparent join-item z-10">
    <div class:list={['header-content', hasTabs ? 'px-2' : 'px-4']}>
      {!hasTabs && (
      <div class="header-start">
        <span class="uppercase para-xs">{lang ?? 'html'}</span>
      </div>
      )}
      <div class:list={['header-end', { 'gap-1 ml-auto': hasTabs }]}>
        {showPreview && (
        <Fragment>
        <label for={toggleId} class="btn btn-xs">
          <span class="is-collapsible-open">{t("Collapse")}</span>
          <span class="is-collapsible-close">{t("Expand")}</span>
        </label>
        <div class="divider divider-vertical"></div>
        </Fragment>
        )}
        <div class="tooltip tooltip-bottom" data-tip="Copy">
          <button type="button" class="snippet-copy-code-btn btn btn-xs btn-plain btn-square" aria-label={t("Copy Snippet")}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <span class="divider divider-horizontal"></span>

  <div class:list={['join-item collapsible', showPreview ? 'collapsible-peek' : 'collapsible-open']}>
    <input type="checkbox" class="collapsible-toggle" id={toggleId} aria-label={t("Toggle code visibility")} checked={checked} />
    <div class:list={['collapsible-content', { 'overflow-auto': !hasTabs }]} translate="no">
      {hasTabs ? (
      <div class="tabs tabs-sm tabs-underline">
        {tabs.map((tab, i) => (
        <Fragment>
        <input type="radio" name={tabName} class="tab" aria-label={tab.label} checked={i === 0} />
        <div class="tab-content overflow-x-auto" set:html={highlighted[i]} />
        </Fragment>
        ))}
      </div>
      ) : (
      <Fragment set:html={highlighted[0]} />
      )}
    </div>
    {showPreview && (
    <label data-pagefind-ignore for={toggleId} class:list={['collapsible-overlay', { 'pointer-events-none': hasTabs }]}>
      <span class:list={['btn btn-xs', { 'pointer-events-auto': hasTabs }]}>{t("View Code")}</span>
    </label>
    )}
  </div>

</div>
