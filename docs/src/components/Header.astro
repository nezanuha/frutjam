---
import config from 'virtual:starlight/user-config';
import Search       from 'virtual:starlight/components/Search';
import SiteTitle    from 'virtual:starlight/components/SiteTitle';
import SocialIcons  from 'virtual:starlight/components/SocialIcons';
import ThemeSelect  from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';

const NAV = [
  { label: 'Docs',       href: '/docs/overview' },
  { label: 'Components', href: '/components/button' },
  { label: 'Blocks',     href: '/blocks/header' },
  { label: 'Blog',       href: '/blog' },
];
---

<div class="header-content fj-header">
  <div class="header-start">
    <SiteTitle />
  </div>

  <div class="header-center">
    <nav class="navbar fj-header-nav" aria-label="Main navigation">
      <ul class="navbar-list gap-x-6">
        {NAV.map((item) => (
          <li>
            <a class="link link-xs link-hover" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="header-end">
    {shouldRenderSearch && (
      <div class="fj-header-search print:hidden">
        <Search />
      </div>
    )}

    <div class="fj-header-actions print:hidden">
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
    </div>

    <details class="fj-header-menu print:hidden">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
             stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
             aria-hidden="true">
          <path d="M4.5 7.5h15M4.5 12h15M4.5 16.5h15" />
        </svg>
      </summary>
      <div class="fj-header-menu__panel">
        <nav aria-label="Site">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="fj-header-menu__prefs">
          <ThemeSelect />
          <div class="sl-flex social-icons"><SocialIcons /></div>
        </div>
      </div>
    </details>
  </div>
</div>

<script>
  const closeMenus = (except?: EventTarget | null) => {
    for (const menu of document.querySelectorAll('details.fj-header-menu[open]')) {
      if (!except || !menu.contains(except as Node)) menu.removeAttribute('open');
    }
  };
  document.addEventListener('click', (e) => closeMenus(e.target));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeMenus();
    const s = document.querySelector('details.fj-header-menu > summary');
    if (s instanceof HTMLElement) s.focus();
  });
  document.addEventListener('pageshow', () => closeMenus());
</script>

<style>
  :global(.page > .header) {
    display: block;
    padding-block: 0;
    height: var(--sl-nav-height);
  }

  .fj-header.header-content {
    padding-inline: 0;
    gap: 1rem;
  }

  .fj-header-nav { display: none; }

  .fj-header-nav :global(.link) {
    color: var(--sl-color-gray-3);
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .fj-header-nav :global(.link:hover) {
    color: var(--sl-color-white);
  }

  .fj-header-search {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    max-width: 16rem;
  }

  .fj-header-search :global(site-search),
  .fj-header-search :global(button[data-open-modal]) {
    width: 100%;
  }

  .fj-header-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .social-icons {
    align-items: center;
    gap: 0.5rem;
  }

  .social-icons::after {
    content: '';
    height: 1.25rem;
    border-inline-end: 1px solid var(--sl-color-hairline);
  }

  @media (min-width: 64rem) {
    .fj-header-nav     { display: flex; }
    .fj-header-actions { display: flex; }
    .fj-header-menu    { display: none; }
  }

  /* Mobile search: square icon button */
  @media (max-width: 63.99rem) {
    .fj-header-search { flex: none; max-width: none; width: auto; }
    .fj-header-search :global(site-search),
    .fj-header-search :global(button[data-open-modal]) { width: 2.25rem; }
    .fj-header-search :global(button[data-open-modal]) {
      height: 2.25rem; padding: 0; justify-content: center;
    }
    .fj-header-search :global(button[data-open-modal] kbd) { display: none; }
  }

  /* Mobile menu */
  .fj-header-menu { position: relative; }

  .fj-header-menu > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .fj-header-menu > summary::-webkit-details-marker { display: none; }

  .fj-header-menu > summary:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .fj-header-menu__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .fj-header-menu__panel ul { list-style: none; margin: 0; padding: 0; }

  .fj-header-menu__panel a {
    display: block;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .fj-header-menu__panel a:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .fj-header-menu__prefs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
</style>
